{
  "openapi": "3.1.0",
  "info": {
    "title": "Trash Fairy — API",
    "version": "1.1.0",
    "summary": "Otwarte API /api/v1 (tylko odczyt, CORS) oraz API aplikacji: kosze, zgłoszenia, trasa kierowcy, dashboard miasta, urządzenia IoT.",
    "description": "Dane operacyjne są syntetyczne (meta.synthetic = true). Pozycje koszy: © OpenStreetMap contributors (ODbL 1.0). Bez kluczy, CORS *, odpowiedzi cache'owane 60 s.",
    "license": {
      "name": "ODbL 1.0 (pozycje z OSM)",
      "identifier": "ODbL-1.0"
    }
  },
  "servers": [
    {
      "url": "https://trashfairy.twapp.pl"
    }
  ],
  "paths": {
    "/api/v1/bins.geojson": {
      "get": {
        "summary": "Wszystkie kosze i altany ze stanem i godziną przekroczenia 85%",
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/BinCollection"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/bins/{id}": {
      "get": {
        "summary": "Jeden kosz z prognozą godzinową na 24 h (przedział p20–p80)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kosz i prognoza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BinDetail"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego kosza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/routes": {
      "get": {
        "summary": "Trasy na najbliższy kurs dla dwóch flot (kosze, altany), kolejność odbioru",
        "responses": {
          "200": {
            "description": "Trasy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Routes"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/conditions": {
      "get": {
        "summary": "Pogoda (mnożnik prognozy) i ruch drogowy (mnożnik czasu przejazdu)",
        "responses": {
          "200": {
            "description": "Warunki",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conditions"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/open-data/miesieczne.csv": {
      "get": {
        "tags": [
          "Otwarte API v1"
        ],
        "summary": "Otwarte dane miesięczne CSV: odbiory, masa i zgłoszenia per dzielnica i frakcja (12 miesięcy, separator „;”)",
        "responses": {
          "200": {
            "description": "CSV UTF-8 z BOM, pierwsza linia: źródło danych (syntetyczne)",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/open-data/miesieczne.json": {
      "get": {
        "tags": [
          "Otwarte API v1"
        ],
        "summary": "Otwarte dane miesięczne JSON (te same agregaty co CSV, meta.synthetic)",
        "responses": {
          "200": {
            "description": "Agregaty",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "miesiac": {
                            "type": "string"
                          },
                          "dzielnica": {
                            "type": "string"
                          },
                          "frakcja": {
                            "type": "string"
                          },
                          "odbiory": {
                            "type": "integer"
                          },
                          "masa_kg": {
                            "type": "number"
                          },
                          "zgloszenia": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/open311/services.json": {
      "get": {
        "tags": [
          "Otwarte API v1"
        ],
        "summary": "Open311 GeoReport v2: rodzaje zgłoszeń (przepelniony, odpady_obok, uszkodzony, inne)",
        "responses": {
          "200": {
            "description": "Lista usług",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/open311/requests.json": {
      "get": {
        "tags": [
          "Otwarte API v1"
        ],
        "summary": "Open311 GeoReport v2: zgłoszenia mieszkańców bez danych osobowych (do 500 najnowszych)",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "description": "Od (ISO 8601)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "Do (ISO 8601; sama data = cały dzień)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "closed"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Zgłoszenia",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "service_request_id": {
                        "type": "string",
                        "example": "TF-00001"
                      },
                      "status": {
                        "enum": [
                          "open",
                          "closed"
                        ]
                      },
                      "service_code": {
                        "type": "string"
                      },
                      "service_name": {
                        "type": "string"
                      },
                      "requested_datetime": {
                        "type": "string"
                      },
                      "updated_datetime": {
                        "type": "string"
                      },
                      "lat": {
                        "type": "number"
                      },
                      "long": {
                        "type": "number"
                      },
                      "address": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Zły parametr (blad, kod)"
          }
        }
      }
    },
    "/api/kosze": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Kosze ze stanem, prognozą przekroczenia 85% i zgłoszeniami (lista do mapy i paneli)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/kosze/{id}": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Jeden kosz: stan, prognoza, termin odbioru, otwarte zgłoszenia z analizą AI zdjęcia",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego kosza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/kosze/{id}/przycisk": {
      "post": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Przycisk na panelu kosza: zgłoszenie bez kodu QR (naciśnięcie = obecność przy koszu). token = token urządzenia panelu, ten sam HMAC co X-Token-Urzadzenia w /api/odczyty",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "typ": "przepelniony",
                "token": "<token urządzenia panelu>"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Przyjęte: {komunikat}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Nieznany typ problemu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Zły token panelu albo kosz bez panelu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego kosza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Więcej niż 3 zgłoszenia na minutę z jednego kosza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/zgloszenia": {
      "post": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Zgłoszenie mieszkańca: tylko z dziennym tokenem z kodu QR panelu tego kosza (bez sprawdzania położenia); zdjęcie (multipart) bez EXIF idzie do analizy AI",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Złe dane albo zdjęcie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Brak albo nieaktualny kod QR (token kosza zmienia się codziennie; wczorajszy działa do 1:00)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Za często (telefon, kosz, adres IP)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "kosz": 18,
                "typ": "przepelniony",
                "qr": "<token z kodu QR>",
                "klient": "id-telefonu",
                "komentarz": "Worki obok kosza"
              }
            }
          }
        }
      }
    },
    "/api/zgloszenia/{nr}": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Status zgłoszenia (przyjęte, w realizacji, zrealizowane) i wynik weryfikacji AI zdjęcia",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego zgłoszenia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "nr",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/trasa": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Trasa kierowcy: przystanki po priorytecie z powodem, postęp kursu, pominięte kosze z powodem i liczba pojazdów",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/odbiory": {
      "post": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Kierowca oznacza kosz jako opróżniony albo zgłasza problem",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Złe dane",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "kosz": 18,
                "akcja": "oproznione"
              }
            }
          }
        }
      }
    },
    "/api/zmiany": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Wersja danych do odświeżania ekranów (polling co kilka sekund)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
