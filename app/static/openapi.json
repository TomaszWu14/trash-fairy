    "/api/odczyty": {
      "post": {
        "tags": [
          "Urządzenia (IoT)"
        ],
        "summary": "Odczyt z urządzenia (czujnik: zapełnienie; panel: sygnał życia). Nagłówek X-Token-Urzadzenia = token wgrany przy montażu",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Wartość spoza zakresu 0–100",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Nieznane urządzenie albo zły token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Częściej niż raz na 10 s",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Token-Urzadzenia",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "numer_seryjny": "TF-US-000133",
                "zapelnienie": 64,
                "autotest_ok": true
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "required": [
          "synthetic",
          "clock"
        ],
        "properties": {
          "synthetic": {
            "type": "boolean",
            "description": "true: poziomy i trasy pochodzą z symulacji"
          },
          "clock": {
            "type": "string",
            "format": "date-time",
            "description": "zegar scenariusza demo"
          },
          "docs": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      },
      "Bin": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "level",
          "state"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "bin",
              "shelter"
            ]
          },
          "name": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "capacity_l": {
            "type": "integer"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 130,
            "description": "szacowane zapełnienie w %"
          },
          "state": {
            "enum": [
              "ok",
              "warn",
              "bad"
            ],
            "description": "ok < 60%, warn 60–85%, bad > 85% albo świeże zgłoszenie"
          },
          "label": {
            "type": "string"
          },
          "fresh": {
            "type": "boolean",
            "description": "zgłoszenie w ostatnich 15 min"
          },
          "crossing": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "przewidywane przekroczenie 85% w ciągu 24 h"
          },
          "next_run": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BinCollection": {
        "type": "object",
        "properties": {
          "type": {
            "const": "FeatureCollection"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Feature"
                },
                "geometry": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "Point"
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "properties": {
                  "$ref": "#/components/schemas/Bin"
                }
              }
            }
          }
        }
      },
      "BinDetail": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "bin": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Bin"
              },
              {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "forecast": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "level": {
                  "type": "integer"
                },
                "low": {
                  "type": "integer"
                },
                "high": {
