    "/api/urzadzenia": {
      "get": {
        "tags": [
          "Urządzenia (IoT)"
        ],
        "summary": "Urządzenia na koszach: bateria, status, odczyty (filtry typ, dzielnica, status)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
