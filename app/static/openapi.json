          "400": {
            "description": "Złe dane",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "kosz": 18,
                "akcja": "oproznione"
              }
            }
          }
        }
      }
    },
    "/api/zmiany": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Wersja danych do odświeżania ekranów (polling co kilka sekund)",
