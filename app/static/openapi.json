    "/api/mieszkaniec/punkty": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Punkty mieszkanki demo „Anna K.”: tylko za potwierdzone zgłoszenia, odznaki, ostatnie pozycje z powodem i katalog nagród jako propozycja dla miasta",
        "responses": {
          "200": {
            "description": "OK",
