    "/api/wysypiska/{nr}/uprzatnieto": {
      "post": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Ekipa MPO oznacza wysypisko jako uprzątnięte (status końcowy z czasem)",
        "parameters": [
          {
            "name": "nr",
            "in": "path",
