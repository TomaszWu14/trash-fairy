{
  "openapi": "3.1.0",
  "info": {
    "title": "Trash Fairy — API",
    "version": "1.1.0",
    "summary": "Otwarte API /api/v1 (tylko odczyt, CORS) oraz API aplikacji: kosze, zgłoszenia, trasa kierowcy, dashboard miasta, urządzenia IoT.",
    "description": "Dane operacyjne są syntetyczne (meta.synthetic = true). Pozycje koszy: © OpenStreetMap contributors (ODbL 1.0). Bez kluczy, CORS *, odpowiedzi cache'owane 60 s.",
    "license": {
      "name": "ODbL 1.0 (pozycje z OSM)",
      "identifier": "ODbL-1.0"
    }
  },
  "servers": [
    {
      "url": "https://trashfairy.twapp.pl"
    }
  ],
  "paths": {
    "/api/v1/bins.geojson": {
      "get": {
        "summary": "Wszystkie kosze i altany ze stanem i godziną przekroczenia 85%",
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/BinCollection"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/bins/{id}": {
      "get": {
        "summary": "Jeden kosz z prognozą godzinową na 24 h (przedział p20–p80)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kosz i prognoza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BinDetail"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego kosza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/routes": {
      "get": {
        "summary": "Trasy na najbliższy kurs dla dwóch flot (kosze, altany), kolejność odbioru",
        "responses": {
          "200": {
            "description": "Trasy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Routes"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/v1/conditions": {
      "get": {
        "summary": "Pogoda (mnożnik prognozy) i ruch drogowy (mnożnik czasu przejazdu)",
        "responses": {
          "200": {
            "description": "Warunki",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conditions"
                }
              }
            }
          }
        },
        "tags": [
          "Otwarte API v1"
        ]
      }
    },
    "/api/kosze": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Kosze ze stanem, prognozą przekroczenia 85% i zgłoszeniami (lista do mapy i paneli)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/kosze/{id}": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Jeden kosz: stan, prognoza, termin odbioru, otwarte zgłoszenia z analizą AI zdjęcia",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego kosza",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/zgloszenia": {
      "post": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Zgłoszenie mieszkańca: tylko z tokenem QR kosza i do 150 m od niego; zdjęcie (multipart) bez EXIF idzie do analizy AI",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Złe dane albo zdjęcie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Za daleko od kosza albo zły kod QR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Za często (telefon, kosz, adres IP)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "kosz": 18,
                "typ": "przepelniony",
                "qr": "<token z kodu QR>",
                "lat": 50.0614,
                "lon": 19.9372,
                "klient": "id-telefonu",
                "komentarz": "Worki obok kosza"
              }
            }
          }
        }
      }
    },
    "/api/zgloszenia/{nr}": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Status zgłoszenia (przyjęte, w realizacji, zrealizowane) i wynik weryfikacji AI zdjęcia",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nie ma takiego zgłoszenia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "nr",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/trasa": {
      "get": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Trasa kierowcy: przystanki po priorytecie z powodem („2 zgłoszenia · 113%”) i postępem kursu",
