          }
        }
      }
    },
    "/api/wysypiska": {
      "post": {
        "tags": [
          "Aplikacja"
        ],
        "summary": "Zgłoszenie dzikiego wysypiska (mieszkaniec albo ekipa MPO): położenie, rodzaje, liczba worków; ze zdjęciem jako multipart (pole zdjecie, bez EXIF). Duplikat do 50 m od otwartego wysypiska z 72 h dołącza do niego; AI tylko opisuje zdjęcie, status nadaje reguła",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "lat": 50.06446,
                "lon": 19.96446,
                "rodzaj": [
                  "bio",
                  "tworzywa"
                ],
                "ilosc": 20,
                "komentarz": "Worki przed bramą ogródków",
                "klient": "id-telefonu",
                "konto": "demo",
                "zrodlo": "ekipa"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Przyjęte",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "numer": "WD-00001",
                  "dolaczone": false,
                  "status": "do_weryfikacji",
                  "etykieta": "Do weryfikacji",
                  "uzasadnienie": "Zgłoszenie bez zdjęcia: miejsce sprawdzi ekipa MPO.",
                  "zdjecie": false
                }
              }
            }
          },
          "400": {
            "description": "Złe dane: brak położenia, miejsce poza Krakowem, rodzaj spoza listy, liczba poza 1–100, złe zdjęcie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Za często (telefon: 1 na 2 min, sieć: 20 na godzinę)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Dashboard miasta"
        ],
        "summary": "Dzikie wysypiska z 90 dni (otwarte i uprzątnięte, bez komentarzy i bez zdjęć z osobami) i miejsca powtórzeń (100 m) z drabinką: tablica, kontrola Straży Miejskiej, fotopułapka (decyzja gminy)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
