# Wzór pliku .env — skopiuj do .env (plik .env jest w .gitignore, nie commituj go).
# Komenda `flask` wczytuje .env sama (python-dotenv). Bez żadnej z tych zmiennych aplikacja działa w pełni na SQLite.

# --- podstawowe ---
SECRET_KEY=YOUR_KEY_HERE                  # podpis tokenów QR i urządzeń; na produkcji obowiązkowy
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/trashfairy   # domyślnie SQLite: trash_fairy.db
# PUBLIC_URL=http://localhost:5000        # adres w kodach QR i na ekranach e-papieru

# --- AI (opcjonalnie; bez klucza zdjęcia trafiają „Do weryfikacji”) ---
ANTHROPIC_API_KEY=YOUR_KEY_HERE
# ANTHROPIC_MODEL=claude-opus-5-5

# --- integracje (opcjonalnie; pusta wartość wyłącza) ---
TOMTOM_API_KEY=YOUR_KEY_HERE              # natężenie ruchu: korekta czasu przejazdu
# OSRM_URL=https://router.project-osrm.org   # przebieg tras po ulicach; puste = linia prosta
# WEATHER_URL=                            # Open-Meteo; puste = bez korekty pogodowej

# --- SMS (kod gotowy w app/sms.py, nieużywany przez żaden ekran) ---
# TWILIO_ACCOUNT_SID=YOUR_KEY_HERE
# TWILIO_AUTH_TOKEN=YOUR_KEY_HERE
# TWILIO_VERIFY_SID=YOUR_KEY_HERE

# --- reguły pilotażu ---
# REQUIRE_CREW_PHOTO=1                    # zdjęcie obowiązkowe przy „Opróżniono”

# --- założenia kosztowe (domyślne wartości z app/methodology.py, do potwierdzenia z przewoźnikiem) ---
# COST_PER_VISIT_PLN=12
# COST_PER_KM_PLN=5
# CO2_KG_PER_KM=1
# COST_QR_STICKER_PLN=5
# COST_PANEL_PLN=600
# COST_HOSTING_MONTH_PLN=300
